{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (clients/vscode/)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/clients/vscode"],
      "outFiles": ["${workspaceFolder}/clients/vscode/out/**/*.js"],
      "preLaunchTask": "vscode: compile"
    }
  ]
}
