{
  "name": "pynakes-desktop",
  "productName": "Pynakes",
  "version": "0.1.0",
  "description": "Standalone reference editor powered by the pynakes engine",
  "author": "Andrea Maiani",
  "license": "MIT",
  "private": true,
  "main": "build/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "npm run build && node scripts/launch.mjs",
    "test": "npm run build && node --test build/test/*.test.cjs",
    "smoke": "npm run build && node scripts/launch.mjs --smoke-test",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "26.6.6",
    "electron": "45.4.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true
  }
}
